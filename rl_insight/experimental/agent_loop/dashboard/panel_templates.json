  "details": {
    "kind": "Panel",
    "spec": {
      "id": 327,
      "title": "Turn details (tool / finish / response)",
      "description": "Each row is one turn: tool, finish reason, and response content.",
      "links": [],
      "data": {
        "kind": "QueryGroup",
        "spec": {
          "queries": [
            {
              "kind": "PanelQuery",
              "spec": {
                "query": {
                  "kind": "DataQuery",
                  "group": "tempo",
                  "version": "v0",
                  "datasource": {
                    "name": "tempo"
                  },
                  "spec": {
                    "limit": 500,
                    "metricsQueryType": "range",
                    "query": "{span.state_lane_id = \"sample=0/session=0/traj=0\" && resource.service.name=\"agent-loop-poc\"} | select(span.turn, span.state_name, span.type, span.tools, span.finish_reason, span.content)",
                    "queryType": "traceql",
                    "serviceMapUseNativeHistograms": false,
                    "spss": 100,
                    "tableType": "spans"
                  }
                },
                "refId": "A",
                "hidden": false
              }
            }
          ],
          "transformations": [
            {
              "kind": "Transformation",
              "group": "organize",
              "spec": {
                "options": {
                  "excludeByName": {
                    "traceIdHidden": true,
                    "spanID": true,
                    "traceService": true,
                    "traceName": true,
                    "service.name": true,
                    "state_lane_id": true,
                    "name": true,
                    "duration": true
                  },
                  "includeByName": {},
                  "indexByName": {
                    "time": 0,
                    "turn": 1,
                    "state_name": 2,
                    "type": 3,
                    "tools": 4,
                    "finish_reason": 5,
                    "content": 6
                  },
                  "renameByName": {
                    "time": "Start",
                    "turn": "Turn",
                    "state_name": "Finish",
                    "type": "Type",
                    "tools": "Tools",
                    "finish_reason": "Finish",
                    "content": "Response"
                  }
                }
              }
            },
            {
              "kind": "Transformation",
              "group": "sortBy",
              "spec": {
                "options": {
                  "fields": {},
                  "sort": [
                    {
                      "field": "turn",
                      "desc": false
                    }
                  ]
                }
              }
            }
          ],
          "queryOptions": {}
        }
      },
      "vizConfig": {
        "kind": "VizConfig",
        "group": "table",
        "version": "13.0.2",
        "spec": {
          "options": {
            "cellHeight": "sm",
            "footer": {
              "countRows": false,
              "enablePagination": false,
              "fields": "",
              "reducer": [
                "sum"
              ],
              "show": false
            },
            "showHeader": true
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "align": "auto",
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "value": 0,
                    "color": "green"
                  }
                ]
              },
              "color": {
                "mode": "thresholds"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Response"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 520
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
