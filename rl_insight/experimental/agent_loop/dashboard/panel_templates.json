{
  "overview": {
    "kind": "Panel",
    "spec": {
      "id": 325,
      "title": "Trajectory Overview",
      "description": "All trajectories in sample 0 / session 0. One row per trajectory (state_lane_id); colored blocks are turn steps.",
      "links": [],
      "data": {
        "kind": "QueryGroup",
        "spec": {
          "queries": [
            {
              "kind": "PanelQuery",
              "spec": {
                "query": {
                  "kind": "DataQuery",
                  "group": "tempo",
                  "version": "v0",
                  "datasource": {
                    "name": "tempo"
                  },
                  "spec": {
                    "limit": 1000,
                    "metricsQueryType": "range",
                    "query": "{span.state_lane_id =~ \"sample=0/session=0/.*\" && resource.service.name=\"agent-loop-poc\"}",
                    "queryType": "traceql",
                    "serviceMapUseNativeHistograms": false,
                    "spss": 100,
                    "tableType": "spans"
                  }
                },
                "refId": "A",
                "hidden": false
              }
            }
          ],
          "transformations": [
            {
              "kind": "Transformation",
              "group": "organize",
              "spec": {
                "options": {
                  "excludeByName": {},
                  "includeByName": {},
                  "indexByName": {},
                  "renameByName": {
                    "time": "Start time",
                    "duration": "Duration"
                  }
                }
              }
            },
            {
              "kind": "Transformation",
              "group": "calculateField",
              "spec": {
                "options": {
                  "binary": {
                    "left": {
                      "matcher": {
                        "id": "byName",
                        "options": "Duration"
                      }
                    },
                    "operator": "/",
                    "right": {
                      "fixed": "1000000"
                    }
                  },
                  "mode": "binary",
                  "reduce": {
                    "reducer": "sum"
                  }
                }
              }
            },
            {
              "kind": "Transformation",
              "group": "calculateField",
              "spec": {
                "options": {
                  "alias": "End time",
                  "mode": "reduceRow",
                  "reduce": {
                    "include": [
                      "Start time",
                      "Duration / 1000000"
                    ],
                    "reducer": "sum"
                  }
                }
              }
            },
            {
              "kind": "Transformation",
              "group": "convertFieldType",
              "spec": {
                "options": {
                  "conversions": [
                    {
                      "destinationType": "time",
                      "targetField": "Start time"
                    },
                    {
                      "destinationType": "time",
                      "targetField": "End time"
                    }
                  ],
                  "fields": {}
                }
              }
            },
            {
              "kind": "Transformation",
              "group": "organize",
              "spec": {
                "options": {
                  "excludeByName": {
                    "Duration": true,
                    "Duration / 1000000": true,
                    "Name": true,
                    "name": true,
                    "Span ID": true,
                    "spanID": true,
                    "Trace Service": true,
                    "traceService": true,
                    "traceIdHidden": true,
                    "service.name": true,
                    "sample": true,
                    "session": true,
                    "session_id": true,
                    "turn": true,
                    "traj": true,
                    "type": true,
                    "tools": true,
                    "finish_reason": true,
                    "content": true,
                    "state_name": true,
                    "sample_success_count": true,
                    "sample_total_trajs": true
                  },
                  "includeByName": {},
                  "indexByName": {},
                  "renameByName": {}
                }
              }
            },
            {
              "kind": "Transformation",
              "group": "partitionByValues",
              "spec": {
                "options": {
                  "fields": [
                    "state_lane_id"
                  ],
                  "keepFields": false
                }
              }
            }
          ],
          "queryOptions": {}
        }
      },
      "vizConfig": {
        "kind": "VizConfig",
        "group": "state-timeline",
        "version": "13.0.2",
        "spec": {
          "options": {
            "alignValue": "left",
            "annotations": {
              "clustering": -1,
              "multiLane": false
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "mergeValues": true,
            "rowHeight": 0.9,
            "showValue": "auto",
            "tooltip": {
              "hideZeros": false,
              "mode": "single",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "length": {
                      "color": "red",
                      "index": 0
                    },
                    "stop": {
                      "color": "blue",
                      "index": 1
                    },
                    "tool_calls": {
                      "color": "yellow",
                      "index": 2
                    },
                    "unknown": {
                      "color": "text",
                      "index": 3
                    }
                  }
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "value": 0,
                    "color": "green"
                  }
                ]
              },
              "color": {
                "mode": "thresholds"
              },
              "custom": {
                "axisPlacement": "auto",
                "fillOpacity": 70,
                "hideFrom": {
                  "legend": false,
                  "tooltip": false,
                  "viz": false
                },
                "insertNulls": false,
                "lineWidth": 0,
                "spanNulls": false
              }
            },
            "overrides": []
          }
        }
      }
    }
  },
